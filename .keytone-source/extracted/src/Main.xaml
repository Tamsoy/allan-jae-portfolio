<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KeyTone" Width="1220" Height="850" MinWidth="1020" MinHeight="690" WindowStartupLocation="CenterScreen" Background="#101318" Foreground="#F2F4F7" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#ABB5C4"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#252D39"/><Setter Property="Foreground" Value="#F2F4F7"/><Setter Property="BorderBrush" Value="#546176"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#8FE1C2"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="White"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#11161E"/><Setter Property="Foreground" Value="#F2F4F7"/><Setter Property="CaretBrush" Value="#8FE1C2"/><Setter Property="BorderBrush" Value="#59677B"/><Setter Property="Padding" Value="10,8"/><Setter Property="SelectionBrush" Value="#397F70"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#101318"/><Setter Property="Background" Value="#EEF2F6"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D5DDE8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,4,18,4"/></Style>
  <Style TargetType="Slider"><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="1"/><Setter Property="SmallChange" Value="0.05"/><Setter Property="LargeChange" Value="0.1"/><Setter Property="MinHeight" Value="27"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#191F28"/><Setter Property="BorderBrush" Value="#333E4D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <DockPanel Margin="28,20,28,16">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Border Background="#8FE1C2" CornerRadius="10" Width="42" Height="42" Margin="0,0,12,0"><TextBlock Text="K" FontSize="25" FontWeight="Bold" Foreground="#12221E" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="KeyTone" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="YOUR EVERYDAY TYPING, RETUNED." FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
   <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center"><Button x:Name="SettingsButton" Content="Profiles &amp; settings" Margin="0,0,10,0"/><Button x:Name="TrayButton" Content="Hide to tray" Margin="0,0,10,0"/><Button x:Name="EnableButton" Content="Sound on" Background="#8FE1C2" Foreground="#12221E" FontWeight="SemiBold" MinWidth="112"/></StackPanel>
  </Grid>
  <Border DockPanel.Dock="Bottom" BorderBrush="#333E4D" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Ready" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" x:Name="ShortcutHint" Text="Ctrl + Alt + K  ·  mute / unmute" FontSize="12" Foreground="{StaticResource Muted}" Margin="16,0,0,0"/></Grid></Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Find your sound." FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Choose a character. Make every key your own." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="ACTIVE PROFILE" Style="{StaticResource Caption}" HorizontalAlignment="Right"/><TextBlock x:Name="ProfileLabel" Text="My keyboard" FontWeight="SemiBold" HorizontalAlignment="Right"/></StackPanel></Grid>
   <UniformGrid x:Name="SwitchPresets" Columns="3" Margin="0,0,-10,10"/>
   <WrapPanel Margin="0,0,0,6"><Button x:Name="AllBlue" Content="All keys blue" Background="#234E7A" Margin="0,0,8,0"/><Button x:Name="AllRed" Content="All keys red" Background="#793C46" Margin="0,0,8,0"/><Button x:Name="AllBrown" Content="All keys brown" Background="#684D35" Margin="0,0,8,0"/><Button x:Name="UndoSwitch" Content="Undo whole-keyboard change" IsEnabled="False"/></WrapPanel>
   <TextBlock Text="All keys replaces individual sounds and tuning. Undo restores them. Mix switches using the key inspector." Style="{StaticResource Caption}" Margin="0,0,0,10"/>
   <Expander Header="More sound styles" Foreground="#D5DDE8" Margin="0,0,0,12"><UniformGrid x:Name="Presets" Columns="5" Margin="0,10,-10,0"/></Expander>
   <Border Style="{StaticResource Card}" Padding="18,10" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="200"/><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Master volume" VerticalAlignment="Center"/><Slider x:Name="MasterVolume" Grid.Column="1" AutomationProperties.Name="Master volume"/><TextBlock x:Name="MasterValue" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><CheckBox x:Name="ReleaseToggle" Content="Release sounds"/><CheckBox x:Name="VariationToggle" Content="Natural variation" Margin="0,4,0,4"/></StackPanel></Grid></Border>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
    <StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your keyboard" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Click a key to edit it. Changes save automatically." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Button x:Name="CaptureButton" Grid.Column="1" Content="Select by typing" Padding="10,6" FontSize="12"/></Grid><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><StackPanel x:Name="Keyboard" Width="780"/></Viewbox><TextBlock Text="ANSI physical layout · other keys: use Select by typing · customized keys have a dot" Style="{StaticResource Caption}" Margin="0,16,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="The typing room" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="ClearTest" Content="Clear" Grid.Column="1" FontSize="12" Padding="10,4" MinHeight="28"/></Grid><TextBox x:Name="TypingTest" AutomationProperties.Name="Typing test — text is never saved" AcceptsReturn="True" TextWrapping="Wrap" Height="74" VerticalScrollBarVisibility="Auto" Margin="0,10,0,8"/><TextBlock Text="Try a few words here, or type in any other app. Test text is never saved." Style="{StaticResource Caption}"/></StackPanel></Border>
    </StackPanel>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top"><StackPanel>
     <TextBlock Text="KEY INSPECTOR" Style="{StaticResource Caption}"/><TextBlock x:Name="SelectedKey" Text="Space" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,2"/><TextBlock x:Name="KeyMode" Text="Following keyboard preset" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
     <TextBlock Text="Sound" Margin="0,0,0,5"/><ComboBox x:Name="KeyPreset" AutomationProperties.Name="Selected key sound"/>
     <UniformGrid Columns="2" Margin="0,8,0,0"><Button x:Name="KeyBlue" Content="Blue switch" Background="#234E7A" FontSize="12" Padding="6,6" Margin="0,0,4,0"/><Button x:Name="KeyRed" Content="Red switch" Background="#793C46" FontSize="12" Padding="6,6" Margin="4,0,0,0"/></UniformGrid>
     <Button x:Name="KeyBrown" Content="Brown switch" Background="#684D35" FontSize="12" Padding="6,6" Margin="0,6,0,0"/>
     <Grid Margin="0,14,0,0"><TextBlock Text="Pitch"/><TextBlock x:Name="PitchValue" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid><Slider x:Name="Pitch" Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="3" AutomationProperties.Name="Key pitch in semitones"/>
     <Grid Margin="0,8,0,0"><TextBlock Text="Tone"/><TextBlock x:Name="ToneValue" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid><Slider x:Name="Tone" Minimum="-1" Maximum="1" AutomationProperties.Name="Key tone, dark to bright"/>
     <Grid Margin="0,8,0,0"><TextBlock Text="Key volume"/><TextBlock x:Name="KeyVolumeValue" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid><Slider x:Name="KeyVolume" Maximum="1.5" AutomationProperties.Name="Selected key volume"/>
     <Button x:Name="PreviewKey" Content="Play this key" Background="#8FE1C2" Foreground="#12221E" FontWeight="SemiBold" Margin="0,14,0,10"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ImportPress" Content="Import press" Padding="5,7" FontSize="12" Margin="0,0,4,0"/><Button x:Name="ImportRelease" Content="Import release" Grid.Column="1" Padding="5,7" FontSize="12" Margin="4,0,0,0"/></Grid><TextBlock x:Name="CustomLabel" Text="Optional: PCM 16-bit WAV, up to 2 sec." Style="{StaticResource Caption}" Margin="0,8,0,10"/>
     <Button x:Name="ResetKey" Content="Reset this key" FontSize="12" Padding="10,6"/>
    </StackPanel></Border>
   </Grid>
   <TextBlock Text="Blue / Red / Brown: recorded Cherry MX switches with ABS keycaps, from Mechvibes (MIT). Five additional synthesized styles. Works offline." Style="{StaticResource Caption}" Margin="2,16,0,0"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
